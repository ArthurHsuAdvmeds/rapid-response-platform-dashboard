// =============================================================================
// qa/data-que.json 範本（schemaVersion 1）
// -----------------------------------------------------------------------------
// 教育訓練課後問卷（Google 表單），給「平台導入成效分析」頁（原型 v10 新增）用；與 data.json 互不影響（這個檔壞掉，只有那一頁顯示「尚無問卷資料」）。
// 目前由使用者本機的 .tool/que_to_json.py 從表單匯出的 xlsx＋場次清單 xlsx 轉出（兩個 xlsx 都留在本機的 kpi/，不進 repo）。
// 一份問卷一個物件，只放代碼與分數：不放姓名、電子郵件、職務、送出的精確時間、自由填寫的原文（repo 與網站都是公開的）。
// 輸出標準 JSON（不要註解、不要結尾逗號）；一個場次、一份問卷各一行。欄位規則見同資料夾 DATA_CONTRACT.md 第 9 節。
// =============================================================================
{
  "schemaVersion": 1,                          // 必填：固定 1（這個檔自己的版本，與 data.json 無關）
  "updatedAt": "2026-11-13T10:07:51+08:00",    // 必填：轉檔時間，帶 +08:00（只記錄用，不影響計算）

  // ---------------------------------------------------------------------------
  // 場次：來自場次清單。只列有問卷的場次；日期篩選以場次日期為準
  // ---------------------------------------------------------------------------
  "sessions": [
    // id：場次代碼，問卷的 session 對到這裡（慣例：日期-am／pm）
    // date：上課日期 YYYY-MM-DD；slot："am" 上午、"pm" 下午；org：辦理單位名稱（選填，畫面顯示時去掉「臺北市政府衛生局」字頭）
    { "id": "2026-09-11-am", "date": "2026-09-11", "slot": "am", "org": "臺北市政府衛生局北投區社區心理衛生中心" },
    { "id": "2026-09-30-am", "date": "2026-09-30", "slot": "am", "org": "三軍總醫院北投分院" }
  ],

  // ---------------------------------------------------------------------------
  // 問卷：一份一個物件。順序不影響計算（轉檔時依場次、單位排序，不保留送出先後）
  // 沒作答的題目給 null；分數一律是整數 1–5
  // ---------------------------------------------------------------------------
  "responses": [
    {
      "session": "2026-09-11-am",              // 必填：場次代碼（sessions[].id）。對不到的不列入，頁首提示份數
      "unit": "health",                        // 填答者自填的就職單位：health 衛政、social 社政、fire 消防、other 其他（單位分析以這題為準）
      "scores": {                              // 滿意度 1–5 分；總滿意度＝四題全部作答的平均
        "ui": 5,                               // 系統介面設計之整體滿意度
        "fit": 5,                              // 系統功能設計符合我的工作實務需求
        "course": 5,                           // 對於本次課程內容、講師說明及教材之整體滿意度
        "flow": 4                              // 系統操作流程之整體滿意度
      },
      "benefit": {                             // 平台使用預期效益：1 非常不同意、2 不同意、3 普通、4 同意、5 非常同意
        "efficiency": 5,                       // 本平台有效提升跨單位通報與轉介效率
        "paperless": 4,                        // 系統自動化與個案追蹤功能，有助於簡化紙本作業
        "quality": 5,                          // 透過本平台更能完整掌握個案處置結果，提升照護品質
        "adopt": 4                             // 我樂意將此平台應用於未來的日常工作中
      },
      // 推廣可能面臨的挑戰（複選）：process 需改變現有作業流程、duplicate 與現有單位內部系統重複輸入、complex 系統操作複雜學習成本高；
      // 「其他」自由填寫歸成 other（有具體挑戰）或 none（無／尚無法判斷）。沒作答 []
      "challenges": ["process", "duplicate"],
      // 建議意見（自由填寫）依主題歸類，一則可屬於多類：manual 教學影片／操作手冊／QA、integrate 系統介接／報表／避免重複登打、
      // font 字體放大／畫面簡化、upload 上傳同意書或附件、permission 權限／資安／瀏覽範圍、other 其他建議；沒有建議（無、暫無…）給 []
      "suggestions": ["manual"],
      // 平台啟用前的經驗：表單較晚才加入這幾題，當時沒有這幾題（或「曾經轉介」那題沒作答）的整塊給 null
      "pre": {
        "referred": true,                      // 曾轉介或通報（疑似）有精神症狀個案：true 曾經轉介、false 不曾轉介、null 沒作答。畫面只算 true
        "ack": "d1",                           // 通報 → 得知受理；以下三題的區間：d0 24 小時內、d1 1–3 天、d4 4–7 天、d8 8–10 天、d11 11–14 天、unknown 無法得知
        "method": "d1",                        // 通報 → 得知處理方式（電訪或決定出勤日）
        "visit": "d4",                         // 通報 → 醫師出勤日
        "result": "passive",                   // 通報後會得知處遇結果嗎：active 主動被告知、passive 被動獲知、none 無法獲知
        "satisfaction": 4                      // 平台啟用前整體轉介滿意度 1–5
      }
    },
    {
      "session": "2026-09-30-am",
      "unit": "other",
      "scores": { "ui": 4, "fit": 4, "course": 4, "flow": 4 },
      "benefit": { "efficiency": 4, "paperless": 4, "quality": 4, "adopt": 3 },
      "challenges": ["none"],
      "suggestions": [],
      "pre": null
    }
  ]
}
