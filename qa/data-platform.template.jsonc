// =============================================================================
// qa/data-platform.json 範本（schemaVersion 1）
// -----------------------------------------------------------------------------
// 只放三處的資料，另外抓、另外產生，與 data.json 互不影響（一個檔壞掉，另一邊照常顯示）：
//   ・醫院內控指標（SNQ）       → snq
//   ・指揮儀表板 → 平台使用率   → usage
//   ・AI模型預測準確率          → ai（2026-11-11 從 data.json 移過來）
// ★ qa 目前隱藏這三處、不讀這個檔（SNQ、平台使用率 2026-11-11；AI 2026-11-09），平台專案可以先不產生；格式保留，恢復時照用。
// snq、usage 是彙總數字；ai 是一筆預測一個物件，但只有分數、版本、日期，不放 reportId 或任何個案、帳號資料。
// 輸出標準 JSON（不要註解、不要結尾逗號）。欄位規則見同資料夾 DATA_CONTRACT.md 第 4 節。
// =============================================================================
{
  "schemaVersion": 1,                          // 必填：固定 1（這個檔自己的版本，與 data.json 無關）
  "updatedAt": "2026-11-09T06:00:05+08:00",    // 必填：撈資料的時間，帶 +08:00

  // ---------------------------------------------------------------------------
  // 指揮儀表板 → 平台使用率：統計到 updatedAt 為止的快照，不受日期篩選影響
  // 使用率＝曾登入過的帳號數 ÷ 總帳號數（從未登入的帳號計入分母）
  // ---------------------------------------------------------------------------
  "usage": {
    "units": [                                 // 一個單位一列，顯示時依使用率高到低排序；單位分類 ★ 待確認
      { "name": "民政", "total": 172, "loggedIn": 131 },   // total 總帳號數、loggedIn 帳號建立後曾登入過的帳號數
      { "name": "社政", "total": 214, "loggedIn": 186 },
      { "name": "消防", "total": 92, "loggedIn": 58 },
      { "name": "教育", "total": 151, "loggedIn": 104 },
      { "name": "勞政", "total": 68, "loggedIn": 37 },
      { "name": "警察", "total": 302, "loggedIn": 248 },
      { "name": "衛政", "total": 108, "loggedIn": 96 },
      { "name": "醫療機構", "total": 70, "loggedIn": 64 }
    ]
  },

  // ---------------------------------------------------------------------------
  // 醫院內控指標（SNQ）：依月份彙總的分子／分母
  // 儀表板把日期區間涵蓋到的月份加總後再除（例如選 10/5–11/9 就加 10、11 月），所以分子、分母都要是「可以相加的人數」。
  // 「月份」是個案進入該指標母群的月份（初診、出院、結案的月份，依各指標定義 ★）。沒有資料的月份可以省略；平台 2026/10/05 啟用，從 2026-10 開始。
  // ---------------------------------------------------------------------------
  "snq": {
    "months": [
      {
        "month": "2026-10",                    // 必填：YYYY-MM
        "homecareFollow":   { "num": 13, "den": 16 },   // 居家醫療個案門診追蹤率：X 年中每年都在門診／居家醫療治療 4 次以上 ÷ 初診為居家醫療個案
        "compulsoryFollow": { "num": 9, "den": 12 },    // 強制住院個案出院後門診追蹤率：出院後 X 年中每年都 4 次以上 ÷ 強制住院出院人數
        "homecareReadmit":  { "num": 3, "den": 16 },    // 初診為居家醫療病人再住院率：再住院個案 ÷ 初診為居家醫療病人
        "compulsoryReadmit":{ "num": 3, "den": 12 },    // 強制住院病人再住院率：再住院個案 ÷ 強制住院病人
        "referral": {                          // 結案後轉介至本院醫療系統比例（分母＝該類別總通報個案數）
          "emergency":    { "den": 17, "any": 12, "opd": 11, "home": 4, "ipd": 5 },   // any：結案日後有門診、居家或住院任一紀錄；opd／home／ipd 各自有紀錄（可重複）
          "optimization": { "den": 25, "any": 14, "opd": 12, "home": 5, "ipd": 4 }
        }
      }
    ]
  },

  // ---------------------------------------------------------------------------
  // AI模型預測準確率：AI 預測分數與專業人員實測分數的比對，全量快照、不受日期篩選影響
  // 散布圖與相關係數用預測、實測都有的筆數；「吻合程度變化」依模型版本第一次出現的 date 排先後，逐版累積
  // ---------------------------------------------------------------------------
  "ai": {
    "predictions": [                           // 一筆預測一個物件；建議依 date 排序。沒有任何預測給 []
      { "date": "2026-10-06", "predicted": 9, "actual": 10, "modelVersion": "1.2" },    // date 預測日期 YYYY-MM-DD；predicted AI 模型預測分數（3–15）
      { "date": "2026-10-18", "predicted": 12, "actual": 11, "modelVersion": "1.2" },   // actual 專業人員實測分數（3–15）；modelVersion 預測時用的模型版本
      { "date": "2026-11-02", "predicted": 7, "actual": null, "modelVersion": "1.3" }   // 還沒實測 actual 給 null（不列入，等有分數再算）
    ]
  }
}
